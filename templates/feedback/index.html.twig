{% extends 'base.html.twig' %}

{% block title %}Обратная связь{% endblock %}

{% block body %}
    <div class="wrapper wrapper-content">
        <div class="row">
            <div class="col-lg-8">
                <div class="ibox">
                    <div class="ibox-title">
                        <h2>Форма обратной связи</h2>
                    </div>
                    <div class="ibox-content">
                        <form method="post" action="{{ path('feedback_form') }}">
                            <div class="form-group">
                                <label for="name">Имя пользователя</label>
                                <input id="name" name="name" type="text" class="form-control" value="{{ formData.name }}">
                                {% if errors.name is defined %}<div class="text-danger m-t-xs">{{ errors.name }}</div>{% endif %}
                            </div>

                            <div class="form-group">
                                <label for="phone">Телефон</label>
                                <input id="phone" name="phone" type="text" class="form-control" value="{{ formData.phone }}">
                                {% if errors.phone is defined %}<div class="text-danger m-t-xs">{{ errors.phone }}</div>{% endif %}
                            </div>

                            <div class="form-group">
                                <label for="email">Почта</label>
                                <input id="email" name="email" type="email" class="form-control" value="{{ formData.email }}">
                                {% if errors.email is defined %}<div class="text-danger m-t-xs">{{ errors.email }}</div>{% endif %}
                            </div>

                            <div class="form-group">
                                <label>Пол</label>
                                <div>
                                    <label class="radio-inline">
                                        <input type="radio" name="gender" value="male" {% if formData.gender == 'male' %}checked{% endif %}> Мужской
                                    </label>
                                    <label class="radio-inline">
                                        <input type="radio" name="gender" value="female" {% if formData.gender == 'female' %}checked{% endif %}> Женский
                                    </label>
                                </div>
                                {% if errors.gender is defined %}<div class="text-danger m-t-xs">{{ errors.gender }}</div>{% endif %}
                            </div>

                            <div class="form-group">
                                <label for="department">Тема сообщения</label>
                                <select id="department" name="department" class="form-control">
                                    <option value="">Выберите тему</option>
                                    {% for key, label in departments %}
                                        <option value="{{ key }}" {% if formData.department == key %}selected{% endif %}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                                {% if errors.department is defined %}<div class="text-danger m-t-xs">{{ errors.department }}</div>{% endif %}
                            </div>

                            <div class="form-group">
                                <label for="message">Текстовое сообщение</label>
                                <textarea id="message" name="message" rows="6" class="form-control">{{ formData.message }}</textarea>
                                {% if errors.message is defined %}<div class="text-danger m-t-xs">{{ errors.message }}</div>{% endif %}
                            </div>

                            <button type="submit" class="btn btn-primary">Отправить</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
